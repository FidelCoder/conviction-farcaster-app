NEXT_PUBLIC_APP_NAME=Conviction Markets
NEXT_PUBLIC_APP_URL=http://localhost:3001
CORE_API_URL=http://localhost:3000

# Production Mini App publishing requires either a signed account association for the exact
# NEXT_PUBLIC_APP_URL domain or a Farcaster hosted manifest id.
FARCASTER_ACCOUNT_ASSOCIATION_JSON=
FARCASTER_HOSTED_MANIFEST_ID=

# Keep true for private/internal tests. Set to false only when the Mini App is ready for discovery.
FARCASTER_MINIAPP_NOINDEX=true

# Server-only AI routes. Do not expose this as NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MEDIA_MODEL=gpt-5.5
OPENAI_SUPPORT_MODEL=gpt-5.5
AI_KEY_ROTATION_INTERVAL_DAYS=30
